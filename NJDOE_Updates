    SUM(CASE WHEN Action = 'UPDATE' THEN 1 ELSE 0 END),
    SUM(CASE WHEN Action = 'NO CHANGE' THEN 1 ELSE 0 END)
FROM [OUTPUT_SCHEMA].Contacts_Changes;


